# NextAuth secret used to sign JWT session tokens (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=

# Public URL of the site (used by NextAuth callbacks)
NEXTAUTH_URL=http://localhost:3000

# Single admin account email
ADMIN_EMAIL=admin@eurasiabusinessgateway.com

# bcrypt hash of the admin password, BASE64-ENCODED to avoid dotenv `$`
# variable expansion mangling the bcrypt hash (bcrypt hashes contain `$`).
#
# Generate with:
#   node -e "const b=require('bcryptjs'); console.log(Buffer.from(b.hashSync('your-password',10)).toString('base64'))"
ADMIN_PASSWORD_HASH=''

# Email sending for the admin "Reply by Email" feature.
#
# Replying uses the SMTP transport you configure in
# Admin > Email Settings (stored in the database). RESEND_API_KEY below is
# only used as a FALLBACK when no SMTP settings have been configured.
# TODO set RESEND_API_KEY and verify domain in Resend dashboard
RESEND_API_KEY=

# SQLite database file location
DATABASE_URL="file:./dev.db"
